{
  "name": "global-private-health-records-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Encrypted, dual-unlock FHIR provenance proof of concept",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/web/server.ts",
    "example": "tsx examples/basic-flow.ts",
    "example:access-denied": "tsx examples/access-denied.ts",
    "start": "tsx src/web/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^18.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
