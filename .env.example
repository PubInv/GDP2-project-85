# Global Patient Record Project: NONSECRET SETTINGS ONLY.
# Copy to .env.local (ignored); use Node --env-file, or set process environment.
# Never put account keys, SAS URLs, private keys, tokens, or real patient data here.
STORAGE_BACKEND=file
STORAGE_FILE_DIRECTORY=.data/web
STORAGE_EMULATOR=false

# Azure: DefaultAzureCredential (az login, managed identity, or workload identity).
# AZURE_STORAGE_ACCOUNT_URL=https://REPLACE.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=synthetic-records

# AWS: default SDK credential chain (aws sso login or a workload role).
# S3_BUCKET=REPLACE
# AWS_REGION=us-east-1
# STORAGE_PREFIX=synthetic-integration/
# S3_KMS_KEY_ID=REPLACE_WITH_KEY_ARN

# IPFS: private Kubo and Cluster APIs via authenticated HTTPS reverse proxies.
# IPFS_PRIVATE_NETWORK=true
# IPFS_API_URL=https://REPLACE
# IPFS_CLUSTER_API_URL=https://REPLACE
# IPFS_METADATA_BACKEND=azure
# IPFS_REPLICATION_MIN=2
# IPFS_REPLICATION_MAX=3
# IPFS_TIMEOUT_MS=30000
# Authorization headers live OUTSIDE the repo in mounted secret files:
# IPFS_API_AUTH_FILE=REPLACE_WITH_ABSOLUTE_SECRET_FILE_PATH
# IPFS_CLUSTER_AUTH_FILE=REPLACE_WITH_ABSOLUTE_SECRET_FILE_PATH
# OR retrieve them from Key Vault with the same Azure workload identity:
# AZURE_KEY_VAULT_URL=https://REPLACE.vault.azure.net
# IPFS_API_AUTH_KEYVAULT_SECRET=ipfs-api-auth
# IPFS_CLUSTER_AUTH_KEYVAULT_SECRET=ipfs-cluster-auth
