# Nonsecret configuration only; replace identifiers with reviewed stack outputs.
STORAGE_BACKEND=ipfs
IPFS_METADATA_BACKEND=dynamodb
DYNAMODB_TABLE=REPLACE_WITH_DynamoDbTable
AWS_REGION=REPLACE_WITH_AwsRegion
IPFS_BACKUP_BACKEND=s3
S3_BUCKET=REPLACE_WITH_S3Bucket
S3_KMS_KEY_ID=REPLACE_WITH_S3KmsKeyId
STORAGE_PREFIX=records/
IPFS_PRIVATE_NETWORK=true
# Provision private DNS, a trusted TLS certificate and authenticated reverse
# proxy independently. These URLs are NOT generated by CloudFormation.
IPFS_API_URL=https://kubo.internal.example.invalid
IPFS_CLUSTER_API_URL=https://cluster.internal.example.invalid
IPFS_REPLICATION_MIN=2
IPFS_REPLICATION_MAX=3
IPFS_API_AUTH_FILE=/run/global-patient-record-secrets/kubo-authorization
IPFS_CLUSTER_AUTH_FILE=/run/global-patient-record-secrets/cluster-authorization
# Never put access keys, factors, private keys, swarm keys or bearer tokens here.
# See docs/AWS_HYBRID_STORAGE.md for external secret-file injection.
