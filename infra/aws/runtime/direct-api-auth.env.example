# Alternative auth fragment, NOT a complete app configuration.
# Remove IPFS_API_AUTH_FILE and IPFS_CLUSTER_AUTH_FILE from app.env.example
# before adding these settings. Do not configure multiple sources per setting.
# AWS_REGION remains required in the base app configuration.
# Values below are secret ARNs only; SecretString holds the complete single-line
# Authorization header. Never put header values or AWS access keys here.
IPFS_API_AUTH_AWS_SECRET_ID=REPLACE_WITH_ApiAuthorizationSecretArn
IPFS_CLUSTER_AUTH_AWS_SECRET_ID=REPLACE_WITH_ClusterAuthorizationSecretArn
