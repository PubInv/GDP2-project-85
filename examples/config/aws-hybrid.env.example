# NONSECRET configuration: fill these using the reviewed AWS stack outputs.
# Copy to an ignored .env.local file; never add actual secret values.
STORAGE_BACKEND=ipfs
STORAGE_EMULATOR=false
IPFS_PRIVATE_NETWORK=true
IPFS_METADATA_BACKEND=dynamodb
IPFS_BACKUP_BACKEND=s3
AWS_REGION=us-east-1
DYNAMODB_TABLE=REPLACE_WITH_METADATA_TABLE
S3_BUCKET=REPLACE_WITH_ENCRYPTED_BACKUP_BUCKET
S3_KMS_KEY_ID=REPLACE_WITH_BACKUP_KMS_KEY_ARN
STORAGE_PREFIX=records/
IPFS_API_URL=https://REPLACE_WITH_PRIVATE_KUBO_API
IPFS_CLUSTER_API_URL=https://REPLACE_WITH_PRIVATE_CLUSTER_API
IPFS_REPLICATION_MIN=2
IPFS_REPLICATION_MAX=3
IPFS_TIMEOUT_MS=30000
IPFS_API_AUTH_AWS_SECRET_ID=REPLACE_WITH_AUTH_HEADER_SECRET_ARN
IPFS_CLUSTER_AUTH_AWS_SECRET_ID=REPLACE_WITH_AUTH_HEADER_SECRET_ARN
